{
  "name": "bot",
  "version": "0.1.0",
  "private": true,
  "description": "Lomi-Test bot — grammY. A thin layer over the API; holds no business logic.",
  "dependencies": {
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "check": "tsx src/main.ts --check",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  }
}
