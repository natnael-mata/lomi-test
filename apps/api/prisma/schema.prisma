// Lomi-Test schema.
//
// Everything hangs off Field → Course → Topic → Question. Per-topic results,
// exam sampling and readiness all roll up through that chain, so the taxonomy
// is built before anything that reads it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An academic programme a student sits the exit exam in — Computer Science,
/// Public Health, Accounting & Finance. Scopes every question that student sees.
///
/// No price column: access is sold by DURATION (6 or 12 months, see PRODUCT.md
/// and TASK.md D2/D3), not per field, so price belongs to Plan. T-020 originally
/// specified `priceEtb` here; that predates the decision and T-140c would have
/// removed it again.
model Field {
  id   String @id @default(cuid())
  /// Display name, e.g. "Accounting & Finance".
  name String
  /// URL-safe identifier used by public routes, e.g. "accounting-finance".
  slug String @unique

  /// The sitting this field is counting down to. Null until the date is known —
  /// the countdown and study plan both key off it.
  examDate DateTime?

  /// Nothing in an unpublished field is served to students, whatever the state
  /// of its questions.
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]
  questions Question[]
  attempts  Attempt[]

  @@index([isPublished])
}

/// A subject within a field — "Data Structures & Algorithms", "Taxation".
/// Groups topics so results can roll up per course as well as per topic.
model Course {
  id      String @id @default(cuid())
  fieldId String
  /// onDelete: Restrict — deleting a field that still has courses is REFUSED.
  ///
  /// Cascade would be catastrophic here: the question bank is the product's
  /// asset, and one delete would silently take every course, topic and question
  /// under it. Fields are retired by setting `isPublished = false`, which stops
  /// them being served without destroying anything. A field is only ever
  /// genuinely deleted after its contents have been dealt with deliberately.
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Display name, e.g. "Data Structures & Algorithms".
  name String
  /// URL-safe identifier, unique within its field — two fields may both have
  /// a "research-methods" course.
  slug String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics Topic[]

  @@unique([fieldId, slug])
  @@index([fieldId])
}

/// The finest unit of the taxonomy — "Sorting", "VAT", "Process Costing".
/// Results roll up per topic, and exam sampling draws against topic weight.
model Topic {
  id       String @id @default(cuid())
  courseId String
  /// Restrict, for the same reason as Course → Field: deleting a course must
  /// not silently take its topics and their questions with it.
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  name String
  slug String

  /// This topic's share of the exam, 0–100, as a percentage.
  ///
  /// DECIMAL, never Float. Weights must sum to exactly 100 (T-024) and binary
  /// floating point cannot represent 0.1 exactly, so a column of Floats will
  /// sum to 99.99999999999999 and fail a check that should pass.
  ///
  /// Null until derived — T-134 computes it from each topic's observed share of
  /// the real past papers, and T-046 refuses to publish a question whose topic
  /// has no weight.
  ///
  /// NOT named `blueprintWeight`, which is what T-022 originally asked for:
  /// there is no official MoE blueprint (decision D5), and a column called
  /// "blueprint" invites the UI to claim "% of exam" — the exact claim the
  /// product cannot support. Student-facing copy says "share of past papers".
  weightPct Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  attempts  Attempt[]

  @@unique([courseId, slug])
  @@index([courseId])
}

/// How a question is answered, which decides how the answer view renders:
/// CONCEPT gets prose, CALCULATION gets a numbered step list whose final step
/// must state the answer choice.
enum QType {
  CONCEPT
  CALCULATION
}

/// Only PUBLISHED is ever served to a student. RETIRED is how a bad question is
/// withdrawn — rows are never deleted, because prior attempts reference them.
enum QStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

/// What the import file SAID about a row — CONTENT-PIPELINE.md §2's `status`
/// column, which is a workflow flag and not a lifecycle state.
///
/// Deliberately a separate vocabulary from `QStatus`. `QStatus` is what this
/// system has decided; `ImportFlag` is what a spreadsheet claimed. Merging them
/// would let `ready` in a CSV mean PUBLISHED here, which is precisely the path a
/// student ends up reading an unreviewed question through.
///
/// `READY` is stored because dropping it would lose provenance, but it grants
/// nothing: the importer never publishes (T-054) and the publish gate decides
/// (T-040…T-046).
enum ImportFlag {
  RAW
  NEEDS_ANSWER
  NEEDS_EXPLANATION
  NEEDS_TOPIC_REVIEW
  READY
}

/// How hard a question is, as the source file rated it — CONTENT-PIPELINE.md §2's
/// optional `difficulty` column.
///
/// A claim by whoever prepared the paper, not a measurement. Once attempts exist
/// the observed success rate is the better signal, and this becomes the starting
/// estimate for a question nobody has answered yet.
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// The product. Everything else exists to get one of these in front of a
/// student with an answer it can defend.
model Question {
  id      String @id @default(cuid())

  /// Human-quotable identifier from the import file — `AF-0003`, `CS-0001`,
  /// `GEO-0001`. Maps to `question_id` in question_import_template.csv.
  ///
  /// Separate from `id` on purpose: `id` is a cuid nobody can read down a phone
  /// line, while this is what a reviewer cites in a bounce note, what content
  /// operations track a bad question by, and what makes re-import idempotent
  /// (T-055 upserts on it rather than creating duplicates).
  ///
  /// Globally unique, not per-field: the prefix already carries the field, and a
  /// collision across fields would mean two questions answering to one name.
  stableId String @unique

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// DENORMALISED from topic → course → field.
  ///
  /// Serving a question is the hottest path in the product — every practice
  /// fetch, and 100 rows per mock sitting — and it always filters "published,
  /// in this student's field". Normalised, that is a three-table join on every
  /// request; here it is one index.
  ///
  /// The cost is that it can drift from the topic's real field, and a drifted
  /// row means a student is served another programme's question. It is written
  /// from the topic at insert time and must be rewritten if a question is ever
  /// moved between topics. T-029a adds a trigger so the database enforces that
  /// rather than trusting every future write path.
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  qType QType

  /// The question itself — the most-read text in the product.
  stem  String

  /// Code shown with the question, kept OUT of the stem so the answer view can
  /// render it in its own monospaced well (DESIGN.md: "code sits in its own
  /// well, separate from prose"). Maps to `code_block` in the import CSV.
  /// Null for the great majority of questions.
  codeBlock String?

  /// One sentence naming what is being tested. Nullable while a question is a
  /// draft; the publish gate (T-042) requires it and rejects multiple sentences.
  conceptLine String?

  /// Prose rationale, for CONCEPT questions. CALCULATION questions carry
  /// ordered `Step` rows instead (T-027), so this stays null for them.
  explanation String?

  /// Pacing budget in seconds. Per D4: 60 for CONCEPT, 180 for CALCULATION —
  /// applied by T-119. Bounded 15..600 by the publish gate (T-045).
  timeLimitSec Int

  status QStatus @default(DRAFT)

  /// Who wrote it and who approved it. Plain ids, not foreign keys, because the
  /// User model does not exist until Phase 3 — T-044's gate rule (reviewer must
  /// differ from author) compares these, and the FKs land with User.
  authorId   String?
  reviewerId String?

  /// The source file's difficulty rating, where it gave one. Null for a question
  /// authored in the app, and for the many source rows that leave it blank.
  ///
  /// Stored rather than dropped (T-053a): the ministry files already carry it,
  /// discarding data on import is the irreversible option, and it is the only
  /// difficulty signal that exists before anyone has attempted the question.
  difficulty Difficulty?

  /// Why the last reviewer sent this back, and what the author has to fix.
  ///
  /// A live instruction, not history: "is there a note" is meant to answer "is
  /// there outstanding work". Clearing it on re-submission lands with T-068a,
  /// which is the only path that will put a question back into review — until
  /// then a note simply persists.
  ///
  /// The permanent record of who bounced what and when is the audit log (T-069).
  /// These are different questions, and conflating them means either losing the
  /// history or showing the author a note about a fix they already made.
  bounceNote String?

  /// Provenance: which source file this came from, e.g.
  /// "Computer_Science_Exit_Exam_2018", plus the exam year when known. Content
  /// operations need to trace a bad question back to the paper it came from.
  sourceRef String?
  year      Int?

  /// Outstanding work as declared by the import file. Empty for a question
  /// authored in the app, which has no import file to declare anything.
  ///
  /// This is what the review queue reads to answer "what is missing from this
  /// question" — the thing a human still has to supply. It is a record of a
  /// claim, never a permission; see the `ImportFlag` comment.
  importFlags ImportFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options  Option[]
  steps    Step[]
  attempts Attempt[]

  @@index([topicId])
  @@index([status])
  /// The question-serving hot path: published questions in one field.
  @@index([fieldId, status])
}

/// One line of a worked solution, for CALCULATION questions only.
///
/// The answer view renders these as a numbered list, and the publish gate
/// (T-043) requires the LAST step to state the answer choice — "= 8,500 →
/// answer C" — so a student is never left to infer which option the working
/// arrived at.
model Step {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// 1-based position. Named `stepNo`, not `order`: ORDER is a reserved SQL
  /// keyword, and this schema is queried by hand often enough that needing
  /// `"order"` quoted in every statement is a standing papercut.
  stepNo Int

  text String

  /// Optional formula line rendered in its own well above the step's prose,
  /// e.g. "1,150,000 × 15/115". Null when the step is purely narrative.
  formula String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// No two steps may occupy the same position in one solution.
  @@unique([questionId, stepNo])
  @@index([questionId])
}

/// A–D. An enum rather than free text so the database itself refuses an
/// option "E" or a lowercase "b" — the import pipeline normalises lettering
/// from messy source files, and this is the backstop when it gets it wrong.
enum OptionLabel {
  A
  B
  C
  D
}

/// One of the four answers. Deleted with its question (Cascade) because an
/// option has no meaning apart from it — unlike a question, which is retired
/// rather than deleted precisely so attempts keep referencing it.
model Option {
  id         String      @id @default(cuid())
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  label      OptionLabel

  text      String
  isCorrect Boolean @default(false)

  /// Why this option is wrong, and why it tempted the student. Required on every
  /// distractor before publish (T-041); null on the correct option, which is
  /// explained by `conceptLine` plus the explanation or steps.
  whyWrong String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One A, one B, one C, one D per question — no duplicate letters.
  @@unique([questionId, label])
  @@index([questionId])
}

/// What was done to a question, by whom, and when.
///
/// Append-only history, deliberately separate from `Question.bounceNote`: that
/// column is the outstanding instruction and gets overwritten, this is the record
/// and never does. Conflating them means either losing the history or showing an
/// author a complaint about a fix they already made.
///
/// Not a foreign key to Question on purpose — an audit row must outlive whatever
/// it describes. Questions are retired rather than deleted today, but a log that
/// a delete can erase is not a log.
model AuditLog {
  id String @id @default(cuid())

  /// Who did it. A plain id, like `Question.authorId`: the User model lands in
  /// Phase 3, and the FK lands with it.
  actorId String

  action AuditAction

  /// The question this concerns, by `id`, plus its `stableId` copied in so the
  /// log stays readable after the row it points at is gone.
  questionId String
  stableId   String

  /// Free text for the action that needs it — the note a bounce carried, the
  /// blast radius a retirement reported.
  detail String?

  createdAt DateTime @default(now())

  @@index([questionId, createdAt])
  @@index([actorId, createdAt])
}

/// The actions worth a permanent record: the ones that change what a student
/// can see, or that a person may later have to answer for.
enum AuditAction {
  PUBLISHED
  BOUNCED
  RETIRED
}

/// A student.
///
/// Two ways in, one row: phone + OTP on the web, Telegram `initData` inside the
/// bot. Both are optional and at least one is always present — a user with
/// neither could never sign in again, so the linking flow (T-081) exists to fold
/// two identities into one row rather than leaving a person with two accounts and
/// one subscription.
model User {
  id String @id @default(cuid())

  /// E.164, unique when present. Null for a Telegram-only account.
  phone           String?   @unique
  phoneVerifiedAt DateTime?

  /// Telegram's numeric id, held as a STRING: it is an identifier, not a
  /// quantity, and ids past 2^53 must not round through a JS number.
  telegramId       String?   @unique
  telegramUsername String?

  /// What other students see. Never the legal name — PRODUCT.md is explicit that
  /// a verified real name appears on no public surface (T-086).
  displayName String

  /// The name as given, for support and receipts. Not shown to other students.
  name String?

  /// The programme this student is sitting. Null until chosen; T-085 refuses to
  /// serve a question without it.
  fieldId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  attempts Attempt[]

  @@index([fieldId])
}

/// One signed-in device.
///
/// Sessions are rows rather than only JWT claims because the product promises
/// two things a stateless token cannot do: list a student's devices, and revoke
/// one immediately (T-083, T-084). A token whose session row is gone or revoked
/// is refused however valid its signature.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// A short label for the device list — "Chrome on Android". Never an IP.
  deviceLabel String?

  /// Set when the session is ended, by revocation or by eviction. Kept rather
  /// than deleted so "signed out on 3 August" can still be answered.
  revokedAt DateTime?
  /// Why it ended: the student revoked it, or a third login evicted it (T-082).
  revokedReason String?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, revokedAt])
}

/// One answer, by one student, to one question.
///
/// The row is the record of what happened, not a scoreboard entry: it keeps the
/// option chosen and the time taken, so a wrong answer can be explained back to
/// the student and a slow correct one can be shown as pacing rather than failure.
///
/// Never deleted. `Question` is RETIRED rather than removed precisely so these
/// keep pointing at something (T-070), and a student's history that points at
/// nothing is worse than a withdrawn question.
model Attempt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// DENORMALISED from the question, for the same reason as `Question.fieldId`:
  /// every progress query is "this student, in this field", and the alternative
  /// is a join on the largest table in the product.
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// DENORMALISED likewise — per-topic readiness (T-135) groups by this.
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// What the student picked. Null is not allowed: an attempt with no answer is
  /// not an attempt, it is a question that was displayed.
  chosenLabel OptionLabel

  /// Resolved at write time rather than recomputed on read. If a question is
  /// later corrected, the student's result must stay what it was when they sat
  /// it — recomputing would silently rewrite their history.
  isCorrect Boolean

  /// Seconds the student spent. Compared against the question's `timeLimitSec`
  /// for pacing (T-109); over the limit is never scored as failure.
  timeTakenSec Int

  createdAt DateTime @default(now())

  /// The hot paths: "this student's attempts in this field", and "has this
  /// student already answered this question".
  @@index([userId, fieldId, createdAt])
  @@index([userId, questionId])
  @@index([userId, topicId])
}

/// What a staff member may do.
///
/// REVIEWER reads the queue and authors the answer content the import cannot
/// carry; ADMIN additionally publishes and retires. Kept apart because
/// publishing is what puts text in front of a student and retiring withdraws it,
/// while reviewing is only ever a proposal.
enum StaffRole {
  REVIEWER
  ADMIN
}

/// Who is allowed near `/admin/*`.
///
/// A separate table rather than a `role` column on `User`, for two reasons. The
/// first is mechanical: a second session is editing `User` on another branch, and
/// this file may only be appended to. The second matters more — **staff is an
/// explicit list, not a default**. A column means every one of the tens of
/// thousands of student rows carries an authorisation field that a bad migration
/// or a careless `updateMany` could flip; a table means being staff requires a
/// row to exist, and the empty state is "nobody".
///
/// Not a foreign key to `User`, following `AuditLog` and the pre-Phase-3
/// `authorId` convention: this file cannot add a relation to an existing model
/// without editing it.
model StaffMember {
  id String @id @default(cuid())

  /// The `User.id` this grants. Unique — one row per person, so revoking is a
  /// single delete with nothing left behind.
  userId String @unique

  role StaffRole

  /// Who granted it and when. Access that nobody can account for is how a
  /// forgotten contractor keeps reading the question bank.
  grantedBy String
  createdAt DateTime @default(now())

  @@index([role])
}
