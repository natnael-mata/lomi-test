// Lomi-Test schema.
//
// Everything hangs off Field → Course → Topic → Question. Per-topic results,
// exam sampling and readiness all roll up through that chain, so the taxonomy
// is built before anything that reads it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An academic programme a student sits the exit exam in — Computer Science,
/// Public Health, Accounting & Finance. Scopes every question that student sees.
///
/// No price column: access is sold by DURATION (6 or 12 months, see PRODUCT.md
/// and TASK.md D2/D3), not per field, so price belongs to Plan. T-020 originally
/// specified `priceEtb` here; that predates the decision and T-140c would have
/// removed it again.
model Field {
  id   String @id @default(cuid())
  /// Display name, e.g. "Accounting & Finance".
  name String
  /// URL-safe identifier used by public routes, e.g. "accounting-finance".
  slug String @unique

  /// The sitting this field is counting down to. Null until the date is known —
  /// the countdown and study plan both key off it.
  examDate DateTime?

  /// Nothing in an unpublished field is served to students, whatever the state
  /// of its questions.
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@index([isPublished])
}

/// A subject within a field — "Data Structures & Algorithms", "Taxation".
/// Groups topics so results can roll up per course as well as per topic.
model Course {
  id      String @id @default(cuid())
  fieldId String
  /// onDelete: Restrict — deleting a field that still has courses is REFUSED.
  ///
  /// Cascade would be catastrophic here: the question bank is the product's
  /// asset, and one delete would silently take every course, topic and question
  /// under it. Fields are retired by setting `isPublished = false`, which stops
  /// them being served without destroying anything. A field is only ever
  /// genuinely deleted after its contents have been dealt with deliberately.
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Display name, e.g. "Data Structures & Algorithms".
  name String
  /// URL-safe identifier, unique within its field — two fields may both have
  /// a "research-methods" course.
  slug String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics Topic[]

  @@unique([fieldId, slug])
  @@index([fieldId])
}

/// The finest unit of the taxonomy — "Sorting", "VAT", "Process Costing".
/// Results roll up per topic, and exam sampling draws against topic weight.
model Topic {
  id       String @id @default(cuid())
  courseId String
  /// Restrict, for the same reason as Course → Field: deleting a course must
  /// not silently take its topics and their questions with it.
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  name String
  slug String

  /// This topic's share of the exam, 0–100, as a percentage.
  ///
  /// DECIMAL, never Float. Weights must sum to exactly 100 (T-024) and binary
  /// floating point cannot represent 0.1 exactly, so a column of Floats will
  /// sum to 99.99999999999999 and fail a check that should pass.
  ///
  /// Null until derived — T-134 computes it from each topic's observed share of
  /// the real past papers, and T-046 refuses to publish a question whose topic
  /// has no weight.
  ///
  /// NOT named `blueprintWeight`, which is what T-022 originally asked for:
  /// there is no official MoE blueprint (decision D5), and a column called
  /// "blueprint" invites the UI to claim "% of exam" — the exact claim the
  /// product cannot support. Student-facing copy says "share of past papers".
  weightPct Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]

  @@unique([courseId, slug])
  @@index([courseId])
}

/// How a question is answered, which decides how the answer view renders:
/// CONCEPT gets prose, CALCULATION gets a numbered step list whose final step
/// must state the answer choice.
enum QType {
  CONCEPT
  CALCULATION
}

/// Only PUBLISHED is ever served to a student. RETIRED is how a bad question is
/// withdrawn — rows are never deleted, because prior attempts reference them.
enum QStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

/// The product. Everything else exists to get one of these in front of a
/// student with an answer it can defend.
model Question {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  qType QType

  /// The question itself — the most-read text in the product.
  stem  String

  /// One sentence naming what is being tested. Nullable while a question is a
  /// draft; the publish gate (T-042) requires it and rejects multiple sentences.
  conceptLine String?

  /// Prose rationale, for CONCEPT questions. CALCULATION questions carry
  /// ordered `Step` rows instead (T-027), so this stays null for them.
  explanation String?

  /// Pacing budget in seconds. Per D4: 60 for CONCEPT, 180 for CALCULATION —
  /// applied by T-119. Bounded 15..600 by the publish gate (T-045).
  timeLimitSec Int

  status QStatus @default(DRAFT)

  /// Who wrote it and who approved it. Plain ids, not foreign keys, because the
  /// User model does not exist until Phase 3 — T-044's gate rule (reviewer must
  /// differ from author) compares these, and the FKs land with User.
  authorId   String?
  reviewerId String?

  /// Provenance: which source file this came from, e.g.
  /// "Computer_Science_Exit_Exam_2018", plus the exam year when known. Content
  /// operations need to trace a bad question back to the paper it came from.
  sourceRef String?
  year      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options Option[]
  steps   Step[]

  @@index([topicId])
  @@index([status])
}

/// One line of a worked solution, for CALCULATION questions only.
///
/// The answer view renders these as a numbered list, and the publish gate
/// (T-043) requires the LAST step to state the answer choice — "= 8,500 →
/// answer C" — so a student is never left to infer which option the working
/// arrived at.
model Step {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// 1-based position. Named `stepNo`, not `order`: ORDER is a reserved SQL
  /// keyword, and this schema is queried by hand often enough that needing
  /// `"order"` quoted in every statement is a standing papercut.
  stepNo Int

  text String

  /// Optional formula line rendered in its own well above the step's prose,
  /// e.g. "1,150,000 × 15/115". Null when the step is purely narrative.
  formula String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// No two steps may occupy the same position in one solution.
  @@unique([questionId, stepNo])
  @@index([questionId])
}

/// A–D. An enum rather than free text so the database itself refuses an
/// option "E" or a lowercase "b" — the import pipeline normalises lettering
/// from messy source files, and this is the backstop when it gets it wrong.
enum OptionLabel {
  A
  B
  C
  D
}

/// One of the four answers. Deleted with its question (Cascade) because an
/// option has no meaning apart from it — unlike a question, which is retired
/// rather than deleted precisely so attempts keep referencing it.
model Option {
  id         String      @id @default(cuid())
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  label      OptionLabel

  text      String
  isCorrect Boolean @default(false)

  /// Why this option is wrong, and why it tempted the student. Required on every
  /// distractor before publish (T-041); null on the correct option, which is
  /// explained by `conceptLine` plus the explanation or steps.
  whyWrong String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One A, one B, one C, one D per question — no duplicate letters.
  @@unique([questionId, label])
  @@index([questionId])
}
