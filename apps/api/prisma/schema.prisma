// Lomi-Test schema.
//
// Everything hangs off Field → Course → Topic → Question. Per-topic results,
// exam sampling and readiness all roll up through that chain, so the taxonomy
// is built before anything that reads it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An academic programme a student sits the exit exam in — Computer Science,
/// Public Health, Accounting & Finance. Scopes every question that student sees.
///
/// No price column: access is sold by DURATION (6 or 12 months, see PRODUCT.md
/// and TASK.md D2/D3), not per field, so price belongs to Plan. T-020 originally
/// specified `priceEtb` here; that predates the decision and T-140c would have
/// removed it again.
model Field {
  id   String @id @default(cuid())
  /// Display name, e.g. "Accounting & Finance".
  name String
  /// URL-safe identifier used by public routes, e.g. "accounting-finance".
  slug String @unique

  /// The sitting this field is counting down to. Null until the date is known —
  /// the countdown and study plan both key off it.
  examDate DateTime?

  /// Nothing in an unpublished field is served to students, whatever the state
  /// of its questions.
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]
  questions Question[]
  attempts  Attempt[]

  @@index([isPublished])
}

/// A subject within a field — "Data Structures & Algorithms", "Taxation".
/// Groups topics so results can roll up per course as well as per topic.
model Course {
  id      String @id @default(cuid())
  fieldId String
  /// onDelete: Restrict — deleting a field that still has courses is REFUSED.
  ///
  /// Cascade would be catastrophic here: the question bank is the product's
  /// asset, and one delete would silently take every course, topic and question
  /// under it. Fields are retired by setting `isPublished = false`, which stops
  /// them being served without destroying anything. A field is only ever
  /// genuinely deleted after its contents have been dealt with deliberately.
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Display name, e.g. "Data Structures & Algorithms".
  name String
  /// URL-safe identifier, unique within its field — two fields may both have
  /// a "research-methods" course.
  slug String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics Topic[]

  @@unique([fieldId, slug])
  @@index([fieldId])
}

/// The finest unit of the taxonomy — "Sorting", "VAT", "Process Costing".
/// Results roll up per topic, and exam sampling draws against topic weight.
model Topic {
  id       String @id @default(cuid())
  courseId String
  /// Restrict, for the same reason as Course → Field: deleting a course must
  /// not silently take its topics and their questions with it.
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  name String
  slug String

  /// This topic's share of the exam, 0–100, as a percentage.
  ///
  /// DECIMAL, never Float. Weights must sum to exactly 100 (T-024) and binary
  /// floating point cannot represent 0.1 exactly, so a column of Floats will
  /// sum to 99.99999999999999 and fail a check that should pass.
  ///
  /// Null until derived — T-134 computes it from each topic's observed share of
  /// the real past papers, and T-046 refuses to publish a question whose topic
  /// has no weight.
  ///
  /// NOT named `blueprintWeight`, which is what T-022 originally asked for:
  /// there is no official MoE blueprint (decision D5), and a column called
  /// "blueprint" invites the UI to claim "% of exam" — the exact claim the
  /// product cannot support. Student-facing copy says "share of past papers".
  weightPct Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  attempts  Attempt[]

  @@unique([courseId, slug])
  @@index([courseId])
}

/// How a question is answered, which decides how the answer view renders:
/// CONCEPT gets prose, CALCULATION gets a numbered step list whose final step
/// must state the answer choice.
enum QType {
  CONCEPT
  CALCULATION
}

/// Only PUBLISHED is ever served to a student. RETIRED is how a bad question is
/// withdrawn — rows are never deleted, because prior attempts reference them.
enum QStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

/// What the import file SAID about a row — CONTENT-PIPELINE.md §2's `status`
/// column, which is a workflow flag and not a lifecycle state.
///
/// Deliberately a separate vocabulary from `QStatus`. `QStatus` is what this
/// system has decided; `ImportFlag` is what a spreadsheet claimed. Merging them
/// would let `ready` in a CSV mean PUBLISHED here, which is precisely the path a
/// student ends up reading an unreviewed question through.
///
/// `READY` is stored because dropping it would lose provenance, but it grants
/// nothing: the importer never publishes (T-054) and the publish gate decides
/// (T-040…T-046).
enum ImportFlag {
  RAW
  NEEDS_ANSWER
  NEEDS_EXPLANATION
  NEEDS_TOPIC_REVIEW
  READY
}

/// How hard a question is, as the source file rated it — CONTENT-PIPELINE.md §2's
/// optional `difficulty` column.
///
/// A claim by whoever prepared the paper, not a measurement. Once attempts exist
/// the observed success rate is the better signal, and this becomes the starting
/// estimate for a question nobody has answered yet.
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// The product. Everything else exists to get one of these in front of a
/// student with an answer it can defend.
model Question {
  id String @id @default(cuid())

  /// Human-quotable identifier from the import file — `AF-0003`, `CS-0001`,
  /// `GEO-0001`. Maps to `question_id` in question_import_template.csv.
  ///
  /// Separate from `id` on purpose: `id` is a cuid nobody can read down a phone
  /// line, while this is what a reviewer cites in a bounce note, what content
  /// operations track a bad question by, and what makes re-import idempotent
  /// (T-055 upserts on it rather than creating duplicates).
  ///
  /// Globally unique, not per-field: the prefix already carries the field, and a
  /// collision across fields would mean two questions answering to one name.
  stableId String @unique

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// DENORMALISED from topic → course → field.
  ///
  /// Serving a question is the hottest path in the product — every practice
  /// fetch, and 100 rows per mock sitting — and it always filters "published,
  /// in this student's field". Normalised, that is a three-table join on every
  /// request; here it is one index.
  ///
  /// The cost is that it can drift from the topic's real field, and a drifted
  /// row means a student is served another programme's question. It is written
  /// from the topic at insert time and must be rewritten if a question is ever
  /// moved between topics. T-029a adds a trigger so the database enforces that
  /// rather than trusting every future write path.
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  qType QType

  /// The question itself — the most-read text in the product.
  stem String

  /// Code shown with the question, kept OUT of the stem so the answer view can
  /// render it in its own monospaced well (DESIGN.md: "code sits in its own
  /// well, separate from prose"). Maps to `code_block` in the import CSV.
  /// Null for the great majority of questions.
  codeBlock String?

  /// One sentence naming what is being tested. Nullable while a question is a
  /// draft; the publish gate (T-042) requires it and rejects multiple sentences.
  conceptLine String?

  /// Prose rationale, for CONCEPT questions. CALCULATION questions carry
  /// ordered `Step` rows instead (T-027), so this stays null for them.
  explanation String?

  /// Pacing budget in seconds. Per D4: 60 for CONCEPT, 180 for CALCULATION —
  /// applied by T-119. Bounded 15..600 by the publish gate (T-045).
  timeLimitSec Int

  status QStatus @default(DRAFT)

  /// Who wrote it and who approved it. Plain ids, not foreign keys, because the
  /// User model does not exist until Phase 3 — T-044's gate rule (reviewer must
  /// differ from author) compares these, and the FKs land with User.
  authorId   String?
  reviewerId String?

  /// The source file's difficulty rating, where it gave one. Null for a question
  /// authored in the app, and for the many source rows that leave it blank.
  ///
  /// Stored rather than dropped (T-053a): the ministry files already carry it,
  /// discarding data on import is the irreversible option, and it is the only
  /// difficulty signal that exists before anyone has attempted the question.
  difficulty Difficulty?

  /// Why the last reviewer sent this back, and what the author has to fix.
  ///
  /// A live instruction, not history: "is there a note" is meant to answer "is
  /// there outstanding work". Clearing it on re-submission lands with T-068a,
  /// which is the only path that will put a question back into review — until
  /// then a note simply persists.
  ///
  /// The permanent record of who bounced what and when is the audit log (T-069).
  /// These are different questions, and conflating them means either losing the
  /// history or showing the author a note about a fix they already made.
  bounceNote String?

  /// Provenance: which source file this came from, e.g.
  /// "Computer_Science_Exit_Exam_2018", plus the exam year when known. Content
  /// operations need to trace a bad question back to the paper it came from.
  sourceRef String?
  year      Int?

  /// Outstanding work as declared by the import file. Empty for a question
  /// authored in the app, which has no import file to declare anything.
  ///
  /// This is what the review queue reads to answer "what is missing from this
  /// question" — the thing a human still has to supply. It is a record of a
  /// claim, never a permission; see the `ImportFlag` comment.
  importFlags ImportFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options  Option[]
  steps    Step[]
  attempts Attempt[]

  @@index([topicId])
  @@index([status])
  /// The question-serving hot path: published questions in one field.
  @@index([fieldId, status])
}

/// One line of a worked solution, for CALCULATION questions only.
///
/// The answer view renders these as a numbered list, and the publish gate
/// (T-043) requires the LAST step to state the answer choice — "= 8,500 →
/// answer C" — so a student is never left to infer which option the working
/// arrived at.
model Step {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// 1-based position. Named `stepNo`, not `order`: ORDER is a reserved SQL
  /// keyword, and this schema is queried by hand often enough that needing
  /// `"order"` quoted in every statement is a standing papercut.
  stepNo Int

  text String

  /// Optional formula line rendered in its own well above the step's prose,
  /// e.g. "1,150,000 × 15/115". Null when the step is purely narrative.
  formula String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// No two steps may occupy the same position in one solution.
  @@unique([questionId, stepNo])
  @@index([questionId])
}

/// A–D. An enum rather than free text so the database itself refuses an
/// option "E" or a lowercase "b" — the import pipeline normalises lettering
/// from messy source files, and this is the backstop when it gets it wrong.
enum OptionLabel {
  A
  B
  C
  D
}

/// One of the four answers. Deleted with its question (Cascade) because an
/// option has no meaning apart from it — unlike a question, which is retired
/// rather than deleted precisely so attempts keep referencing it.
model Option {
  id         String      @id @default(cuid())
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  label      OptionLabel

  text      String
  isCorrect Boolean @default(false)

  /// Why this option is wrong, and why it tempted the student. Required on every
  /// distractor before publish (T-041); null on the correct option, which is
  /// explained by `conceptLine` plus the explanation or steps.
  whyWrong String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One A, one B, one C, one D per question — no duplicate letters.
  @@unique([questionId, label])
  @@index([questionId])
}

/// What was done to a question, by whom, and when.
///
/// Append-only history, deliberately separate from `Question.bounceNote`: that
/// column is the outstanding instruction and gets overwritten, this is the record
/// and never does. Conflating them means either losing the history or showing an
/// author a complaint about a fix they already made.
///
/// Not a foreign key to Question on purpose — an audit row must outlive whatever
/// it describes. Questions are retired rather than deleted today, but a log that
/// a delete can erase is not a log.
model AuditLog {
  id String @id @default(cuid())

  /// Who did it. A plain id, like `Question.authorId`: the User model lands in
  /// Phase 3, and the FK lands with it.
  actorId String

  action AuditAction

  /// What was acted on: `question`, `topic`, `exam`, `user`.
  ///
  /// Widened from question-only in T-167. Every admin mutation is auditable, and
  /// half of them are not about a question — a weight override, a paper being
  /// built, a device reset. A second audit table would have been the easier
  /// change and the wrong one: "where is the record" must have one answer.
  entity   String
  entityId String

  /// A human-readable reference, copied in so the log stays legible after the
  /// row it points at is gone — a question's `stableId`, a topic's name.
  reference String?

  /// Kept for the question actions that predate the widening, so existing rows
  /// and existing queries still resolve. `entityId` is the general form.
  questionId String?
  stableId   String?

  /// Free text for the action that needs it — the note a bounce carried, the
  /// blast radius a retirement reported.
  detail String?

  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([questionId, createdAt])
  @@index([actorId, createdAt])
}

/// The actions worth a permanent record: the ones that change what a student
/// can see, or that a person may later have to answer for.
enum AuditAction {
  PUBLISHED
  BOUNCED
  RETIRED
  /// T-167: the admin mutations that are not about a question.
  WEIGHTS_DERIVED
  WEIGHT_OVERRIDDEN
  WEIGHT_OVERRIDE_CLEARED
  EXAM_BUILT
  DEVICES_RESET
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
}

/// A student.
///
/// Two ways in, one row: phone + OTP on the web, Telegram `initData` inside the
/// bot. Both are optional and at least one is always present — a user with
/// neither could never sign in again, so the linking flow (T-081) exists to fold
/// two identities into one row rather than leaving a person with two accounts and
/// one subscription.
model User {
  id String @id @default(cuid())

  /// E.164, unique when present. Null for a Telegram-only account.
  phone           String?   @unique
  phoneVerifiedAt DateTime?

  /// Telegram's numeric id, held as a STRING: it is an identifier, not a
  /// quantity, and ids past 2^53 must not round through a JS number.
  telegramId       String? @unique
  telegramUsername String?

  /// What other students see. Never the legal name — PRODUCT.md is explicit that
  /// a verified real name appears on no public surface (T-086).
  displayName String

  /// The name as given, for support and receipts. Not shown to other students.
  name String?

  /// The programme this student is sitting. Null until chosen; T-085 refuses to
  /// serve a question without it.
  fieldId String?

  /// Set when an operator deactivates the account (T-164). Reversible, and a
  /// timestamp rather than a boolean so "when" is answerable without the audit
  /// log — the first question support asks is when it happened.
  ///
  /// A deactivated account cannot sign in and every live session is revoked.
  deactivatedAt DateTime?

  /// Whether this is a repeat sitting, asked once at onboarding (D8, T-166).
  ///
  /// **Nullable on purpose, and it drives nothing.** Null means nobody asked,
  /// which is not the same as "no" — treating an unasked student as a first-time
  /// sitter is the kind of quiet assumption that later shows up as a wrong
  /// number in a report. It is reserved for segmentation and there is a test
  /// asserting nothing in the product branches on it.
  isRetaker Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  attempts Attempt[]

  @@index([fieldId])
}

/// One signed-in device.
///
/// Sessions are rows rather than only JWT claims because the product promises
/// two things a stateless token cannot do: list a student's devices, and revoke
/// one immediately (T-083, T-084). A token whose session row is gone or revoked
/// is refused however valid its signature.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// A short label for the device list — "Chrome on Android". Never an IP.
  deviceLabel String?

  /// Set when the session is ended, by revocation or by eviction. Kept rather
  /// than deleted so "signed out on 3 August" can still be answered.
  revokedAt     DateTime?
  /// Why it ended: the student revoked it, or a third login evicted it (T-082).
  revokedReason String?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, revokedAt])
}

/// One answer, by one student, to one question.
///
/// The row is the record of what happened, not a scoreboard entry: it keeps the
/// option chosen and the time taken, so a wrong answer can be explained back to
/// the student and a slow correct one can be shown as pacing rather than failure.
///
/// Never deleted. `Question` is RETIRED rather than removed precisely so these
/// keep pointing at something (T-070), and a student's history that points at
/// nothing is worse than a withdrawn question.
model Attempt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// DENORMALISED from the question, for the same reason as `Question.fieldId`:
  /// every progress query is "this student, in this field", and the alternative
  /// is a join on the largest table in the product.
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// DENORMALISED likewise — per-topic readiness (T-135) groups by this.
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// What the student picked. Null is not allowed: an attempt with no answer is
  /// not an attempt, it is a question that was displayed.
  chosenLabel OptionLabel

  /// Resolved at write time rather than recomputed on read. If a question is
  /// later corrected, the student's result must stay what it was when they sat
  /// it — recomputing would silently rewrite their history.
  isCorrect Boolean

  /// Seconds the student spent. Compared against the question's `timeLimitSec`
  /// for pacing (T-109); over the limit is never scored as failure.
  timeTakenSec Int

  createdAt DateTime @default(now())

  /// The hot paths: "this student's attempts in this field", and "has this
  /// student already answered this question".
  @@index([userId, fieldId, createdAt])
  @@index([userId, questionId])
  @@index([userId, topicId])
}

/// What a staff member may do.
///
/// REVIEWER reads the queue and authors the answer content the import cannot
/// carry; ADMIN additionally publishes and retires. Kept apart because
/// publishing is what puts text in front of a student and retiring withdraws it,
/// while reviewing is only ever a proposal.
enum StaffRole {
  REVIEWER
  ADMIN
}

/// Who is allowed near `/admin/*`.
///
/// A separate table rather than a `role` column on `User`, for two reasons. The
/// first is mechanical: a second session is editing `User` on another branch, and
/// this file may only be appended to. The second matters more — **staff is an
/// explicit list, not a default**. A column means every one of the tens of
/// thousands of student rows carries an authorisation field that a bad migration
/// or a careless `updateMany` could flip; a table means being staff requires a
/// row to exist, and the empty state is "nobody".
///
/// Not a foreign key to `User`, following `AuditLog` and the pre-Phase-3
/// `authorId` convention: this file cannot add a relation to an existing model
/// without editing it.
model StaffMember {
  id String @id @default(cuid())

  /// The `User.id` this grants. Unique — one row per person, so revoking is a
  /// single delete with nothing left behind.
  userId String @unique

  role StaffRole

  /// Who granted it and when. Access that nobody can account for is how a
  /// forgotten contractor keeps reading the question bank.
  grantedBy String
  createdAt DateTime @default(now())

  @@index([role])
}

/// Why a sitting stopped.
///
/// Recorded separately from `closedAt` (when the row settled) and `endsAt` (when
/// it expired): a sitting that ran out at 13:00 and was settled three days later
/// must not read as "submitted three days later". Same discipline as
/// `Session.revokedAt` / `revokedReason`.
enum SittingCloseReason {
  SUBMITTED
  EXPIRED
}

/// A frozen mock paper for one field.
///
/// The questions belong HERE, not to a sitting: two sittings of the same exam
/// must get identical questions (T-120), and T-138 labels sittings "Mock 1/2/3"
/// against it. With a launch bank of ~95–102 publishable rows, a 100-question
/// draw is very nearly the whole bank anyway, so per-sitting sampling would buy
/// almost no variation for a great deal of machinery.
///
/// `fieldId` is a plain scalar with no Prisma relation — the same convention as
/// `AuditLog` and `Question.authorId`. The foreign key is added in hand-written
/// migration SQL so this model can be **appended** without editing `Field`, whose
/// block a parallel Phase 8 session is also changing.
///
/// The mix is COLUMNS, not constants, for the same reason T-121 moves duration
/// out of a constant: an exam's shape is data about that exam.
model Exam {
  id      String @id @default(cuid())
  fieldId String

  /// Unique within its field — "mock-1". Mirrors `Course.@@unique([fieldId, slug])`.
  slug String
  /// Student-facing label: "Mock 1".
  name String

  /// SECONDS, like every other duration here (`Question.timeLimitSec`,
  /// `Attempt.timeTakenSec`). 10800 = 180 minutes. Minutes would put a ×60
  /// between the two numbers T-121a exists to reconcile.
  durationSec Int

  conceptCount     Int
  calculationCount Int

  /// False stops NEW sittings without disturbing ones in progress — which is how
  /// a retirement is handled (T-071). Sampling filters on PUBLISHED; a frozen
  /// paper does not shrink under a student mid-sitting.
  isActive Boolean @default(true)

  /// Building a paper is an operator action, not a side effect of a student
  /// pressing Start.
  builtBy String
  builtAt DateTime

  /// Achieved-versus-target topic distribution. Recorded because the per-topic
  /// quota is deliberately soft — D5's weights are derived and explicitly not
  /// official — and a number nobody can check is the decoration DESIGN.md forbids.
  topicPlan Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions ExamQuestion[]
  sittings  Sitting[]

  @@unique([fieldId, slug])
  @@index([fieldId, isActive])
}

/// One slot on a frozen paper.
///
/// `qType`, `timeLimitSec` and `topicId` are SNAPSHOTS taken at freeze time. A
/// reviewer may patch `Question.timeLimitSec` to anything in 15..600 at any
/// moment, and a re-import used to revert it. Without the copy, a paper that has
/// already been sat stops summing to its sitting length and T-121a becomes untrue
/// for history.
///
/// Unlike `Question.fieldId` (T-029a), this drift is INTENDED. Do not add a
/// trigger to "fix" it.
model ExamQuestion {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Plain scalars; foreign keys in SQL. Question is ON DELETE RESTRICT — the
  /// bank is the asset.
  questionId String
  topicId    String

  /// 1-based, like `Step.stepNo`. Named for its position because ORDER is a
  /// reserved SQL keyword.
  position     Int
  qType        QType
  timeLimitSec Int

  createdAt DateTime @default(now())

  /// No two questions in one slot, and no question twice on one paper — a
  /// duplicate silently turns a 100-question form into a 99-question one.
  @@unique([examId, position])
  @@unique([examId, questionId])
  @@index([questionId])
}

/// One student's run at one paper.
///
/// `startedAt` is written by the APPLICATION, never `@default(now())`: that
/// compiles to database-side `CURRENT_TIMESTAMP`, and every DateTime here is
/// `TIMESTAMP(3)` without a time zone. A Postgres session on `Africa/Addis_Ababa`
/// would stamp the start three hours away from an `endsAt` computed in Node, and
/// the sitting would expire the instant it began. Both come from one `now`, read
/// once, in one place.
model Sitting {
  id     String @id @default(cuid())
  userId String
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// DENORMALISED from the exam, for the same reason as `Attempt.fieldId`: every
  /// "my sittings in this programme" query would otherwise join through Exam.
  fieldId String

  startedAt DateTime

  /// MATERIALISED at start as `startedAt + durationSec`, never recomputed from
  /// the Exam on read. Editing `Exam.durationSec` must not move the deadline of a
  /// sitting already under way — an admin fixing a typo would otherwise cut
  /// students off mid-question.
  endsAt DateTime

  /// When the row settled, which is not when it expired. Null means open.
  ///
  /// Every liveness check is `closedAt IS NULL AND now <= endsAt`, never a status
  /// column: an abandoned sitting must not read as live forever, or it inflates
  /// T-070's blast radius and blocks the student's next start.
  closedAt    DateTime?
  closeReason SittingCloseReason?

  /// Null until close. Zero would claim the student scored nothing.
  scoreCorrect  Int?
  answeredCount Int?

  /// Support only. The sitting is keyed to the USER, not the session: two
  /// concurrent devices are allowed by design, and a session-bound sitting would
  /// lose ninety minutes when a phone dies.
  startedBySessionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers SittingAnswer[]
  results SittingResult[]

  @@index([userId, fieldId, startedAt])
  @@index([closedAt, endsAt])
  @@index([examId])
}

/// A student's in-progress answer. Mutable until close — T-125 lets them change
/// their mind — and carrying NO correctness of any kind.
///
/// This is the strongest thing the schema can do for T-124: with no correctness
/// column on the row every in-sitting endpoint reads, no `select` and no
/// `include` can leak the key. That is one better than building payloads by
/// listing what goes in — it removes the thing to forget.
///
/// `chosenLabel` is NULLABLE, in deliberate contrast to `Attempt.chosenLabel`:
/// "visited and blank" and "flagged and blank" are real states here (T-125, T-126).
model SittingAnswer {
  id        String  @id @default(cuid())
  sittingId String
  sitting   Sitting @relation(fields: [sittingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  questionId String

  chosenLabel OptionLabel?
  isFlagged   Boolean      @default(false)
  answeredAt  DateTime?

  /// Which device wrote it. Support only; never authority.
  answeredBySessionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Last-write-wins target. Without it two devices answering one question
  /// produce two rows, the score exceeds 100 and the topic breakdown
  /// double-counts. Also the reconnect-sync upsert key for T-131.
  @@unique([sittingId, questionId])
  @@index([sittingId])
}

/// A graded question. Created ONLY inside the close transaction — one row per
/// question on the paper, including the ones never answered.
///
/// Correctness is frozen here for the same reason as `Attempt.isCorrect`: a later
/// correction must not rewrite a student's mock score.
///
/// Keeping grading in a table that has no rows before close makes T-124
/// assertable as a COUNT — while the sitting is open, `sittingResult.count()` is
/// zero — which is also exactly T-129's "none before".
model SittingResult {
  id        String  @id @default(cuid())
  sittingId String
  sitting   Sitting @relation(fields: [sittingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  questionId String
  topicId    String

  /// Null means never answered. Recorded honestly rather than inventing a
  /// letter; `isCorrect` is false either way.
  chosenLabel OptionLabel?
  isCorrect   Boolean

  createdAt DateTime @default(now())

  @@unique([sittingId, questionId])
  @@index([sittingId])
  @@index([topicId])
}

/// A reviewer's override of a topic's derived weight (T-134a).
///
/// A separate table rather than columns on `Topic`, for the same reason
/// `StaffMember` is separate from `User`: a derived value and a human's
/// correction of it are two different facts, and storing the correction *over*
/// the derivation destroys the thing it was correcting. Keeping them apart means
/// `Topic.weightPct` is always the effective weight, this row always says why it
/// is not the derived one, and re-deriving the bank never silently erases a
/// judgement somebody made on purpose.
///
/// The reason is required. An override with no reason is indistinguishable from
/// a typo six months later, and the next reviewer has no way to tell whether to
/// keep it.
model TopicWeightOverride {
  id      String @id @default(cuid())
  topicId String @unique

  /// The weight a reviewer asserted, 0–100, whole percent.
  weightPct Int

  /// What the bank said before the override, kept so the size of the correction
  /// stays visible after the bank has moved on.
  derivedPct Int

  /// Required — see the note above.
  reason String

  /// Who, by staff id. No FK: an override outlives the person who left.
  setBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId])
}

/// One attempt to sign in on the web via the Telegram bot (T-075–T-078).
///
/// The row exists so a sign-in is a *fact the server owns*, not a claim either
/// side makes. The browser holds `pollSecret` and never puts it in the deep
/// link; the bot supplies the Telegram identity and never sees the secret. A
/// session comes out only when both halves arrive on the same row.
///
/// **`pollSecretHash`, not the secret.** This table is the one an attacker with
/// read access would go for: a plaintext column would hand them every in-flight
/// login. Hashed, a database leak is worth nothing after two minutes.
model LoginRequest {
  id String @id @default(cuid())

  /// Public. Travels in `t.me/<bot>?start=login_<nonce>` and is safe to be seen —
  /// on its own it cannot produce a session.
  nonce String @unique

  /// SHA-256 of the browser's secret. See the note above.
  pollSecretHash String

  /// Shown on the web page and repeated by the bot, so a student confirming has
  /// something to check the request against.
  pairingCode String

  /// Set by the bot once the student confirms it was them.
  approvedAt       DateTime?
  telegramId       String?
  telegramUsername String?

  /// Set when the student taps Cancel. Distinct from expiry: "somebody tried to
  /// sign in as me" is worth being able to find later.
  declinedAt DateTime?

  /// Set when the browser exchanges its secret. Single-use is enforced on this.
  claimedAt DateTime?
  sessionId String?

  /// Whoever asked, for the bot to show and for rate limiting. Best-effort.
  requestedFromIp String?
  deviceLabel     String?

  /// Two minutes out. A login link is a session sitting in a chat log.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([createdAt])
}

/// A student's relationship with the Telegram bot (T-180, T-181, T-182).
///
/// A separate table rather than three columns on `User`, for the same reason
/// `StaffMember` and `TopicWeightOverride` are separate: `User` is the one model
/// the parallel payments branch also has to extend, and two sessions editing the
/// same lines is the one merge conflict this project has gone out of its way to
/// avoid. It also keeps a student who has never opened the bot out of the table
/// entirely, which is the honest representation — there is no relationship yet.
///
/// `referredVia` sits here because a referral code arrives through the bot's
/// `/start` deep link and nowhere else today. If a web referral path appears, it
/// belongs on `User` and should move.
model BotProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// The `/start` payload that brought them in — "amb_123" (T-180).
  ///
  /// Set ONCE, on the first arrival, and never overwritten. Whoever introduced a
  /// student did so once; letting a later link rewrite it would let anybody
  /// claim someone else's referral by sending them a fresh link.
  referredVia String?

  /// True stops every nudge (T-182). Default false: a student who opened the bot
  /// asked for it. Opting out is one tap and takes effect on the next run.
  botOptOut Boolean @default(false)

  /// The last date a daily question went out, as a plain YYYY-MM-DD **string**.
  ///
  /// A string, not a DateTime, and deliberately: "did this student already get
  /// today's question" is a question about a calendar day in Addis, not about an
  /// instant. A timestamp invites a comparison against `now - 24h`, which drifts
  /// the send time earlier every day until it lands at 3am.
  lastDailySentOn String?

  /// The chat to send to. Telegram's numeric id, held as a string for the same
  /// reason `User.telegramId` is: it is an identifier, not a quantity.
  chatId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botOptOut, lastDailySentOn])
}
