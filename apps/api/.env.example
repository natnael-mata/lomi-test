# Read by the PRISMA CLI only.
#
# Prisma looks for .env in the schema's own project directory and does not read
# the workspace root, so this file exists purely so `prisma migrate` and
# `prisma generate` can find the database. Everything else lives in the root
# .env — do not duplicate it here.
#
# DATABASE_URL must match the root .env exactly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lomi_test
