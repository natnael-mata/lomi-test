{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Lomi-Test API \u2014 NestJS + Prisma + PostgreSQL. The single source of truth.",
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "unplugin-swc": "^1.5.9"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:dev": "node scripts/db-dev.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:status": "prisma migrate status",
    "prisma:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-questions.ts",
    "dev:session": "tsx scripts/dev-session.ts",
    "dev:publish": "tsx scripts/dev-publish.ts",
    "dev:staff": "tsx scripts/dev-staff.ts",
    "import:csv": "tsx src/import/import.cli.ts"
  }
}
