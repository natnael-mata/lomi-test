# Where to deploy. Copy to deploy/deploy.env and fill in — deploy.env is
# gitignored, because it names a host and a login.
#
# These values are the shared 196.190.212.158 box ("Alet Cloud"), which also
# runs Chaw Taxi, EIMS, Elpis and Semayawi. Read deploy/README.md before the
# first run: nothing here may disturb a neighbour.

SSH_TARGET=chaw-taxi
SSH_PORT=22

# Everything Lomi-Test owns lives here and nowhere else.
REMOTE_ROOT=/srv/lomi-test

# The hostname. Follows the *.196-190-212-158.nip.io pattern the four existing
# sites already use, so no domain purchase and no DNS change is needed.
LOMI_HOST=lomi.196-190-212-158.nip.io

# Ports verified free on that box (3000 Chaw, 3001 Chaw admin, 3300 legacy
# callback, 4100 Semayawi, 5432 Postgres, 8090 EIMS are taken). deploy.sh
# refuses to start if something that is not ours is holding one.
API_PORT=4400
WEB_PORT=3400
