# Where to deploy. Copy to deploy/deploy.env and fill in — deploy.env is
# gitignored, because it names a host and a login.

# user@host of the box.
SSH_TARGET=
# Non-standard on some of these boxes.
SSH_PORT=22

# Everything Lomi-Test owns lives here and nowhere else.
REMOTE_ROOT=/srv/lomi-test

# Ports nothing else on the box is using. deploy.sh refuses to start if
# something that is not ours is already holding one.
API_PORT=4400
WEB_PORT=3400
