# Lomi-Test — copy to .env and fill in. Never commit .env.
#
# TWO env files exist and both are gitignored:
#   .env           — read by the apps at runtime
#   apps/api/.env  — read by the PRISMA CLI, which looks in the schema's own
#                    project directory and does NOT read the workspace root.
# DATABASE_URL must be identical in both. Changing one and not the other is the
# classic "migrations hit the wrong database" bug.

# ─── database ────────────────────────────────────────────────────────────────
# Dev runs embedded Postgres on 5433 (npm run db:dev) — 5432 is taken by the
# system Postgres on this machine. Production points at a managed Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lomi_test

# Overrides for the dev cluster only (apps/api/scripts/db-dev.mjs).
# Defaults shown; normally leave these unset.
# PGPORT=5433
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=lomi_test

# ─── api ─────────────────────────────────────────────────────────────────────
API_PORT=4000

# Sign the access/refresh tokens. Generate with: openssl rand -base64 48
# A weak or shared secret means forged sessions — treat it as a credential.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── telegram ────────────────────────────────────────────────────────────────
# From @BotFather. Also the HMAC key that validates Mini App initData, so the
# bot token IS the Mini App's auth secret — rotating it signs everyone out.
TELEGRAM_BOT_TOKEN=

# The bot's @name WITHOUT the @. Used to build the web sign-in deep link
# (t.me/<name>?start=login_<nonce>). A value with the @ still in it produces a
# link that 404s, which reads as "sign-in is broken" rather than as a typo.
TELEGRAM_BOT_USERNAME=

# ─── bot → api authentication ────────────────────────────────────────────────
# Shared secret on the routes only the bot may call: /auth/login-link/:nonce/
# approve, /decline and /prompt. Anything able to reach `approve` with a chosen
# Telegram id can sign in as that person, so this is the most sensitive value
# in the file after the bot token.
#
# **Unset means those routes refuse everything**, deliberately — a guard that
# opens when its config is missing looks like protection while being a bypass.
# Generate with: openssl rand -hex 32
BOT_SHARED_SECRET=

# ─── sms ─────────────────────────────────────────────────────────────────────
# UNUSED as of 2026-08-05. Sign-in is the Telegram deep link (T-075–T-078), not
# an SMS code — a bot cannot message a phone number, so the OTP shape did not
# port. Kept here only because a phone number is still collected at checkout,
# via Telegram's own request_contact, which needs no provider. Delete these two
# once nothing in the tree mentions them.
SMS_API_KEY=
SMS_SENDER_ID=

# ─── payments ────────────────────────────────────────────────────────────────
# Chapa, from https://dashboard.chapa.co → Settings → API keys. The test key
# starts CHASECK_TEST-, the live one CHASECK-. There is no stub mode: without a
# key the three Chapa routes answer 503 rather than pretending to take money.
CHAPA_SECRET_KEY=
# Chapa's dashboard lets you set a separate webhook secret. If you do, put it
# here; if you leave it blank the signature is checked against CHAPA_SECRET_KEY,
# which is what Chapa signs with by default.
CHAPA_WEBHOOK_SECRET=
# Where Chapa's hosted checkout sends the student back to. Must be reachable
# from their browser, so localhost only works in development.
WEB_BASE_URL=http://localhost:3100

# ─── bot → api ───────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:4000
# Shared secret the bot presents to internal API routes. Generate like JWT_SECRET.
BOT_INTERNAL_TOKEN=

# ─── web ─────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* is inlined into the browser bundle and is PUBLIC. Never put a
# secret behind this prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
