{
  "name": "lomi-test",
  "version": "0.1.0",
  "private": true,
  "description": "Lomi-Test (ሎሚ) — exit-exam preparation for Ethiopian university students",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "dev:bot": "npm run dev -w bot",
    "db:dev": "npm run db:dev -w api",
    "prisma:migrate": "npm run prisma:migrate -w api",
    "prisma:generate": "npm run prisma:generate -w api",
    "prisma:deploy": "npm run prisma:deploy -w api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node scripts/runner-report.mjs test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "db:seed": "npm run db:seed --workspace api --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
